---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../site.config';

// Each section appears only once it has content. Keep every line specific: a decision, a tool, a result.
// intro: two or three sentences on how you came to design and what a team gets when they hire you.
const intro = '';
// howIWork: one paragraph per string, with one real example.
const howIWork: string[] = [];
// experience: { period: '2025 to now', title: 'UI/UX Designer', org: 'Company', note: 'What you owned and what changed.' }
const experience: { period: string; title: string; org: string; note: string }[] = [];
// skills: { group: 'Research', items: ['User interviews', 'Usability testing'] }
const skills: { group: string; items: string[] }[] = [];
---

<Base title="About" description={`About ${site.name}, ${site.role}.`}>
  <div class="container about">
    <header class="about__head">
      <h1>About me</h1>
      <p class="lead">{intro || `${site.name}, ${site.role} based in ${site.location}.`}</p>
    </header>

    {howIWork.length > 0 && (
      <section class="block" aria-labelledby="how-title">
        <h2 id="how-title">How I work</h2>
        <div class="text">{howIWork.map((p) => <p>{p}</p>)}</div>
      </section>
    )}

    {(experience.length > 0 || site.resume) && (
    <section class="block" aria-labelledby="exp-title">
      <h2 id="exp-title">Experience</h2>
      <ol class="timeline">
        {experience.map((e) => (
          <li>
            <p class="timeline__period">{e.period}</p>
            <div>
              <h3>{e.title}</h3>
              <p class="timeline__org">{e.org}</p>
              <p class="timeline__note">{e.note}</p>
            </div>
          </li>
        ))}
      </ol>
      {site.resume && <p><a href={site.resume} target="_blank" rel="noopener">Full resume (PDF)<span class="visually-hidden"> (opens in a new tab)</span></a></p>}
    </section>
    )}

    {skills.length > 0 && (
    <section class="block" aria-labelledby="skills-title">
      <h2 id="skills-title">Skills and tools</h2>
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>
    )}

    <section class="block" aria-labelledby="reach-title">
      <h2 id="reach-title">Get in touch</h2>
      <div class="text">
        <p>{site.availability}. Based in {site.location}.</p>
        <ContactLinks />
      </div>
    </section>
  </div>
</Base>

<style>
  .about { padding-block: var(--space-8); display: grid; gap: var(--space-8); }
  .about__head { display: grid; gap: var(--space-4); }
  .about__head h1 { font-size: var(--text-4xl); letter-spacing: -0.02em; }
  .block { display: grid; gap: var(--space-5); padding-top: var(--space-6); border-top: 1px solid var(--color-border); }
  @media (min-width: 900px) {
    .block { grid-template-columns: 16rem minmax(0, 1fr); gap: var(--space-8); }
    .block > :not(h2) { grid-column: 2; }
  }
  .block h2 { font-size: var(--text-2xl); }
  .text { display: grid; gap: var(--space-4); max-width: var(--measure); font-size: var(--text-lg); }
  .timeline { list-style: none; display: grid; gap: var(--space-6); max-width: var(--measure); }
  .timeline li { display: grid; gap: var(--space-1); }
  @media (min-width: 640px) { .timeline li { grid-template-columns: 9rem 1fr; gap: var(--space-5); } }
  .timeline__period { font-size: var(--text-sm); color: var(--color-text-secondary); padding-top: 2px; }
  .timeline h3 { font-size: var(--text-lg); }
  .timeline__org { color: var(--color-text-secondary); }
  .timeline__note { margin-top: var(--space-2); }
  .skills { display: grid; gap: var(--space-4); margin: 0; max-width: var(--measure); }
  .skills div { display: grid; gap: var(--space-1); }
  @media (min-width: 640px) { .skills div { grid-template-columns: 9rem 1fr; gap: var(--space-5); } }
  .skills dt { font-weight: var(--weight-bold); }
  .skills dd { margin: 0; color: var(--color-text-secondary); }
</style>
