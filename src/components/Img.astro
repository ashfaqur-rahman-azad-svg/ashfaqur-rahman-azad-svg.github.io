---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Every image on the site goes through here: AVIF first, WebP fallback, quality 88
// (visually lossless for UI with text), sized for 1x and 2x screens.
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes, priority = false, class: className } = Astro.props;
const widths = [480, 800, 1200, 1600, 2000, 2400].filter((w) => w <= src.width);
if (widths.length === 0 || widths[widths.length - 1] < src.width) widths.push(Math.min(src.width, 2400));
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif']}
  fallbackFormat="webp"
  quality={88}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class={className}
/>
