---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { project, priority = false, headingLevel = 'h3' } = Astro.props;
const d = project.data;
const Heading = headingLevel;
const href = `/work/${project.id}`;
---

<article class="feature">
  <div class="feature__media">
    <Img src={d.cover} alt={d.coverAlt} sizes="(min-width: 1024px) 640px, 100vw" priority={priority} />
  </div>
  <div class="feature__body">
    <p class="eyebrow">{[d.year, d.platform].filter(Boolean).join(' · ')}</p>
    <Heading class="feature__title"><a href={href}>{d.title}</a></Heading>
    <p class="feature__summary">{d.summary}</p>
    <dl class="feature__facts">
      <div><dt>Role</dt><dd>{d.role}</dd></div>
      {d.metrics[0] && <div><dt>Result</dt><dd>{d.metrics[0].value} {d.metrics[0].label}</dd></div>}
    </dl>
    <p class="feature__cta" aria-hidden="true">
      Read case study{d.prototypes.length > 0 && ' · Interactive prototype inside'}
    </p>
  </div>
</article>

<style>
  .feature {
    position: relative;
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  .feature__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-media-bg);
    border: 1px solid var(--color-border);
  }
  .feature__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform var(--duration-default) var(--ease);
  }
  .feature:hover .feature__media :global(img) { transform: scale(1.01); }
  .feature__body { display: grid; gap: var(--space-3); max-width: 34rem; }
  .feature__title { font-size: var(--text-2xl); }
  @media (min-width: 1024px) { .feature__title { font-size: var(--text-3xl); } }
  .feature__title a { color: var(--color-text-primary); text-decoration: none; }
  /* The title link covers the whole card so the image is clickable too, with one tab stop. */
  .feature__title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg); }
  .feature__title a:focus-visible { outline: none; }
  .feature__title a:focus-visible::after { outline: 2px solid var(--color-focus); outline-offset: 4px; }
  .feature__summary { color: var(--color-text-secondary); font-size: var(--text-lg); }
  .feature__facts { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin: 0; font-size: var(--text-sm); }
  .feature__facts dt { color: var(--color-text-secondary); }
  .feature__facts dd { margin: 0; font-weight: var(--weight-bold); }
  .feature__cta {
    margin-top: var(--space-2);
    font-weight: var(--weight-bold);
    color: var(--color-action);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .feature:hover .feature__cta { color: var(--color-action-hover); text-decoration-thickness: 2px; }

  @media (min-width: 900px) {
    .feature { grid-template-columns: 7fr 5fr; gap: var(--space-8); }
  }
</style>
