---
import { site } from '../site.config';
import ContactLinks from './ContactLinks.astro';
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container footer__inner">
    <div class="footer__cta">
      <h2>Hiring a designer?</h2>
      <p class="footer__text">{site.availability}. The fastest way to reach me is email; I reply within a working day.</p>
      <ContactLinks />
    </div>
    <p class="footer__meta">&copy; {year} {site.name}. Built with Astro, hosted on GitHub Pages.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
  }
  .footer__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-6);
  }
  .footer__cta { display: grid; gap: var(--space-4); max-width: var(--measure); }
  .footer__cta h2 { font-size: var(--text-3xl); }
  .footer__text { color: var(--color-text-secondary); font-size: var(--text-lg); }
  .footer__meta { font-size: var(--text-sm); color: var(--color-text-secondary); }
</style>
